{
  "hosting": {
    "public": "platform",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/firebase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "functions": [
    { "source": "relay/functions", "codebase": "stark", "ignore": ["node_modules", "test.js", ".git"] }
  ]
}
