rules_version = '2';
// STARK platform security rules.
// The first Google account to sign in becomes the owner (director). The owner adds everyone else
// on the People page; only those accounts can read or change STARK data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function ownerPath() { return /databases/$(database)/documents/config/owner; }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function isOwner() { return signedIn() && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid; }
    function isMember() { return signedIn() && (isOwner() || exists(memberPath())); }
    function isDirector() { return isOwner() || (isMember() && get(memberPath()).data.role == 'director'); }

    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(ownerPath())
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow update, delete: if false;
    }

    match /members/{email} {
      allow read: if isDirector() || (signedIn() && email == myEmail());
      allow create, update: if isDirector()
                    && request.resource.data.role in ['member', 'director']
                    && request.resource.data.name is string;
      allow delete: if isDirector();
    }

    // Platform data, one document per collection (items, missions, bookings, ...).
    // Clearances, the clearance list, the team list and settings are director-only.
    match /stark/{key} {
      allow read: if isMember();
      allow write: if isMember() && (isDirector() || !(key in ['clear', 'skills', 'team', 'config']));
    }

    match /smartlab_snaps/{day} {
      allow read, write: if isDirector();
    }

    // Applications from the public "Restart the Line" test. Anyone may submit once per email
    // (the document id is the email, and only create is allowed); only the director reads them.
    match /applicants/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','uni','major','year','prog','track','total','rooms','secs','at','ua','v'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.uni is string && request.resource.data.uni.size() <= 80
                    && request.resource.data.major is string && request.resource.data.major.size() <= 80
                    && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total <= 500
                    && request.resource.data.rooms is list && request.resource.data.rooms.size() == 5
                    && id.size() <= 120;
      allow read, update, delete: if isDirector();
    }

    // Used only by the Ask STARK relay (server side). Nobody signs in to it directly.
    match /askStarkUsage/{id} {
      allow read, write: if false;
    }
  }
}
